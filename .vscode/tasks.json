{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tailwind: Watch",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "tailwind",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*tailwindcss.*|.*Rebuilding.*",
          "endsPattern": ".*Done in.*|.*Done.*|.*Waiting for.*"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    }
  ]
}

<!-- dashboard.ejs -->

<%- include("../../views/partials/admin/header") %>

<style>
  body {
    background-color: #f4f5f9;
    font-family: "Inter", sans-serif;
  }



  .card {
    border: none;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    background-color: #ffffff;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 12px rgba(0,0,0,0.08);
  }

  .card-body {
    padding: 24px;
  }

  .icontext {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .icontext .icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f0f4f8;
    color: #424649;
    border-radius: 12px !important;
  }
  
  .icontext .icon i {
    font-size: 24px;
  }

  .icontext .text h6 {
    color: #6c757d;
    font-size: 0.9rem;
    margin-bottom: 4px;
    font-weight: 500;
  }

  .icontext .text span {
    color: #212529;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .content-main {
    padding: 20px 30px;
  }

  h2, h5 {
    color: #212529;
    font-weight: 600;
    font-family: "Inter", sans-serif;
  }
  
  hr {
    border-color: #e9ecef;
  }

  @media (max-width: 768px) {
    .content-main {
      padding: 15px;
    }
  }
</style>

<section class="content-main">
  <div class="content-header">
    <div>
      <h2 class="content-title card-title">Dashboard</h2>
      <p class="text-muted font-sm">A complete overview of your store's performance</p>
    </div>
  </div>

  <div class="row">
    <!-- Total Users Card -->
    <div class="col-lg-3 col-md-6 col-sm-12">
      <div class="card card-body mb-4">
        <article class="icontext">
          <span class="icon icon-sm rounded-circle">
            <i class="material-icons md-people"></i>
          </span>
          <div class="text">
            <h6 class="mb-1 card-title">Total Users</h6>
            <span><%- userCount %></span>
          </div>
        </article>
      </div>
    </div>

    <!-- Total Products Card -->
    <div class="col-lg-3 col-md-6 col-sm-12">
      <div class="card card-body mb-4">
        <article class="icontext">
          <span class="icon icon-sm rounded-circle">
            <i class="material-icons md-shopping_bag"></i>
          </span>
          <div class="text">
            <h6 class="mb-1 card-title">Total Products</h6>
            <span><%- productCount %></span>
          </div>
        </article>
      </div>
    </div>

    <!-- Total Products Card -->
    <div class="col-lg-3 col-md-6 col-sm-12">
      <div class="card card-body mb-4">
        <article class="icontext">
          <span class="icon icon-sm rounded-circle">
            <i class="material-icons md-shopping_bag"></i>
          </span>
          <div class="text">
            <h6 class="mb-1 card-title">Total Categories</h6>
            <span><%- categoryCount %></span>
          </div>
        </article>
      </div>
    </div>

    <!-- Total Products Card -->
    <div class="col-lg-3 col-md-6 col-sm-12">
      <div class="card card-body mb-4">
        <article class="icontext">
          <span class="icon icon-sm rounded-circle">
            <i class="material-icons md-shopping_bag"></i>
          </span>
          <div class="text">
            <h6 class="mb-1 card-title">Total Brands</h6>
            <span><%- brandCount %></span>
          </div>
        </article>
      </div>
    </div>

    <!-- Other Cards Here -->
  </div>

  <div class="row">
    <!-- Left Column: Payment & Sales Performance Charts -->
    <div class="col-lg-6 col-md-12 mb-4">
      <!-- Card 1: Payment Method Distribution Pie Chart -->
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2 font-sm">
            <i class="material-icons md-pie_chart text-dark"></i> Payment Methods Distribution
          </h5>
        </div>
        <div id="piechart" class="w-100" style="min-height: 280px;"></div>
      </div>

      <!-- Card 2: Products Sold Bar Chart -->
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2 font-sm">
            <i class="material-icons md-bar_chart text-dark"></i> Product Sales Performance
          </h5>
        </div>
        <div class="w-100 p-2">
          <canvas id="myChart" style="width: 100%; height: 280px;"></canvas>
        </div>
      </div>
    </div>

    <!-- Right Column: Top Selling Analytics -->
    <div class="col-lg-6 col-md-12 mb-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
            <i class="material-icons md-leaderboard text-dark"></i> Top Selling Analytics
          </h4>
          <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-flex align-items-center gap-1 font-xs" type="button" onclick="removeAll()">
            <i class="material-icons md-refresh" style="font-size:16px;"></i> Reset
          </button>
        </div>

        <form action="/admin/dashboard" method="GET" class="mb-4">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 bg-light p-2 rounded-3 border">
            <span class="fw-bold font-xs text-muted px-2"><i class="material-icons md-filter_list" style="font-size:16px;"></i> FILTER</span>
            <div class="btn-group btn-group-sm flex-wrap gap-1" role="group" aria-label="Filter timeline">
              <button type="button" class="btn btn-outline-dark rounded-pill px-3 font-xs fw-bold" id="daily">Day</button>
              <button type="button" class="btn btn-outline-dark rounded-pill px-3 font-xs fw-bold" id="weekly">Week</button>
              <button type="button" class="btn btn-outline-dark rounded-pill px-3 font-xs fw-bold" id="monthly">Month</button>
              <button type="button" class="btn btn-outline-dark rounded-pill px-3 font-xs fw-bold" id="yearly">Year</button>
              <button type="button" class="btn btn-outline-dark rounded-pill px-3 font-xs fw-bold" id="custom">Custom</button>
            </div>
          </div>

          <div id="custom_date_inputs" class="p-3 bg-light rounded-3 border mb-3">
            <div class="row g-2 align-items-center">
              <div class="col-md-5">
                <label for="customFilterStartDate" class="form-label font-xs fw-bold text-muted mb-1">Start Date</label>
                <input type="date" name="startDate" id="customFilterStartDate" class="form-control form-control-sm" />
              </div>
              <div class="col-md-5">
                <label for="customFilterEndDate" class="form-label font-xs fw-bold text-muted mb-1">End Date</label>
                <input type="date" name="endDate" id="customFilterEndDate" class="form-control form-control-sm" />
              </div>
              <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-dark w-100 font-xs fw-bold">Apply</button>
              </div>
            </div>
          </div>
        </form>

        <!-- Top 10 Lists -->
        <div class="d-flex flex-column gap-3">
          <!-- Top Products -->
          <div class="card border rounded-3 overflow-hidden shadow-none">
            <div class="card-header bg-dark text-white py-2 px-3 fw-bold font-sm d-flex justify-content-between align-items-center">
              <span><i class="material-icons md-shopping_bag me-1" style="font-size:16px;"></i> Top 10 Selling Products</span>
              <span class="badge bg-white text-dark font-xs"><%= orderBar ? orderBar.length : 0 %> items</span>
            </div>
            <div class="card-body p-0">
              <ul class="list-group list-group-flush">
                <% if (orderBar && orderBar.length > 0) { %>
                  <% orderBar.slice(0, 10).forEach((item, index) => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                      <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-circle <%= index === 0 ? 'bg-warning text-dark' : (index === 1 ? 'bg-secondary text-white' : (index === 2 ? 'bg-dark text-white' : 'bg-light text-dark border')) %>" style="width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center; font-size:11px;">
                          <%= index + 1 %>
                        </span>
                        <span class="fw-bold font-sm text-dark"><%= item.productName %></span>
                      </div>
                      <span class="badge bg-light text-dark border font-xs"><%= item.totalQuantitySold %> sold</span>
                    </li>
                  <% }) %>
                <% } else { %>
                  <li class="list-group-item text-center py-3 text-muted font-sm">No sales data recorded</li>
                <% } %>
              </ul>
            </div>
          </div>

          <!-- Top Categories -->
          <div class="card border rounded-3 overflow-hidden shadow-none">
            <div class="card-header bg-dark text-white py-2 px-3 fw-bold font-sm d-flex justify-content-between align-items-center">
              <span><i class="material-icons md-category me-1" style="font-size:16px;"></i> Top 10 Selling Categories</span>
              <span class="badge bg-white text-dark font-xs"><%= bestSellingCat ? bestSellingCat.length : 0 %> items</span>
            </div>
            <div class="card-body p-0">
              <ul class="list-group list-group-flush">
                <% if (bestSellingCat && bestSellingCat.length > 0) { %>
                  <% bestSellingCat.slice(0, 10).forEach((item, index) => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                      <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-circle <%= index === 0 ? 'bg-warning text-dark' : 'bg-light text-dark border' %>" style="width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center; font-size:11px;">
                          <%= index + 1 %>
                        </span>
                        <span class="fw-bold font-sm text-dark"><%= item.categoryName %></span>
                      </div>
                      <span class="badge bg-light text-dark border font-xs"><%= item.categoryQuantitySold %> sold</span>
                    </li>
                  <% }) %>
                <% } else { %>
                  <li class="list-group-item text-center py-3 text-muted font-sm">No sales data recorded</li>
                <% } %>
              </ul>
            </div>
          </div>

          <!-- Top Brands -->
          <div class="card border rounded-3 overflow-hidden shadow-none">
            <div class="card-header bg-dark text-white py-2 px-3 fw-bold font-sm d-flex justify-content-between align-items-center">
              <span><i class="material-icons md-stars me-1" style="font-size:16px;"></i> Top 10 Selling Brands</span>
              <span class="badge bg-white text-dark font-xs"><%= bestSellingBrands ? bestSellingBrands.length : 0 %> items</span>
            </div>
            <div class="card-body p-0">
              <ul class="list-group list-group-flush">
                <% if (bestSellingBrands && bestSellingBrands.length > 0) { %>
                  <% bestSellingBrands.slice(0, 10).forEach((item, index) => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                      <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-circle <%= index === 0 ? 'bg-warning text-dark' : 'bg-light text-dark border' %>" style="width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center; font-size:11px;">
                          <%= index + 1 %>
                        </span>
                        <span class="fw-bold font-sm text-dark"><%= item.brandName %></span>
                      </div>
                      <span class="badge bg-light text-dark border font-xs"><%= item.brandQuantitySold %> sold</span>
                    </li>
                  <% }) %>
                <% } else { %>
                  <li class="list-group-item text-center py-3 text-muted font-sm">No sales data recorded</li>
                <% } %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<script>
  function removeAll() {
    window.location.href = "/admin/dashboard"; 
  }

const customDateInputs = document.getElementById("custom_date_inputs");
customDateInputs.style.display = "block"; // Initially hidden

const dailyButton = document.getElementById("daily");
const weeklyButton = document.getElementById("weekly");
const monthlyButton = document.getElementById("monthly");
const yearlyButton = document.getElementById("yearly");
const customButton = document.getElementById("custom");
const startDateInput = document.getElementById("customFilterStartDate");
const endDateInput = document.getElementById("customFilterEndDate");
const form = document.querySelector("form");

// List of all buttons
const buttons = [dailyButton, weeklyButton, monthlyButton, yearlyButton, customButton];

// Global variable to store the selected report type
let selectedReportType = 'daily'; // Default value can be 'daily'

// Update the selected report type based on button clicks
function setActive(button, reportType) {
  buttons.forEach(btn => {
    btn.classList.remove('btn-dark', 'text-white', 'active', 'shadow-sm');
    btn.classList.add('btn-outline-dark');
  });

  button.classList.remove('btn-outline-dark');
  button.classList.add('btn-dark', 'text-white', 'active', 'shadow-sm');

  selectedReportType = reportType;
  handleReportType(reportType);
}

dailyButton.addEventListener("click", () => setActive(dailyButton, "daily"));
weeklyButton.addEventListener("click", () => setActive(weeklyButton, "weekly"));
monthlyButton.addEventListener("click", () => setActive(monthlyButton, "monthly"));
yearlyButton.addEventListener("click", () => setActive(yearlyButton, "yearly"));
customButton.addEventListener("click", () => setActive(customButton, "custom"));

function handleReportType(reportType) {
  if (reportType === "custom") {
    customDateInputs.style.display = "block";  // Show custom date inputs
  } else {
    customDateInputs.style.display = "none";   // Hide custom date inputs for other filters

    // Automatically set date ranges for non-custom report types
    let startDate, endDate;
    const today = new Date();

    if (reportType === "daily") {
      startDate = endDate = today.toISOString().split("T")[0];
    } else if (reportType === "weekly") {
      const lastWeek = new Date(today);
      lastWeek.setDate(today.getDate() - 7);
      startDate = lastWeek.toISOString().split("T")[0];
      endDate = today.toISOString().split("T")[0];
    } else if (reportType === "monthly") {
      const lastMonth = new Date(today);
      lastMonth.setMonth(today.getMonth() - 1);
      startDate = lastMonth.toISOString().split("T")[0];
      endDate = today.toISOString().split("T")[0];
    } else if (reportType === "yearly") {
      const lastYear = new Date(today);
      lastYear.setFullYear(today.getFullYear() - 1);
      startDate = lastYear.toISOString().split("T")[0];
      endDate = today.toISOString().split("T")[0];
    }

    // Set the hidden input values and submit the form automatically for non-custom types
    startDateInput.value = startDate;
    endDateInput.value = endDate;
    form.submit();  // Automatically submit for non-custom filters
  }
}

// Handle form submission and custom date validation
form.addEventListener("submit", (event) => {
  if (selectedReportType === "custom" && customDateInputs.style.display === 'block') {
    const startDate = startDateInput.value;
    const endDate = endDateInput.value;

    // Validate custom date inputs: Check if start and end dates are valid
    if (!startDate || !endDate || new Date(startDate) > new Date(endDate)) {
      event.preventDefault();  // Prevent form submission if validation fails
      Swal.fire({
        icon: "error",
        title: "Error",
        text: "Please enter a valid input",
        showConfirmButton: false,
        timer: 2000,
      })
      return;
    }
  }
});
</script>

<script type="text/javascript">
  google.charts.load("current", { packages: ["corechart"] });
  google.charts.setOnLoadCallback(drawChart);

  const paymentMethod = JSON.parse('<%- JSON.stringify(order) %>');

  function drawChart() {
    const chartData = [["Payment Method", "User Count"]];

    paymentMethod.forEach((method) => {
      chartData.push([method.paymentMethod, method.userCount]);
    });

    var data = google.visualization.arrayToDataTable(chartData);

    var options = {
      pieHole: 0.4,
      chartArea: { width: "90%", height: "80%" },
      legend: { position: "bottom", textStyle: { fontSize: 13, color: "#495057" } },
      colors: ["#424649", "#6366f1", "#06b6d4", "#10b981", "#f59e0b"],
      fontName: "Inter, sans-serif"
    };

    var chart = new google.visualization.PieChart(document.getElementById("piechart"));
    chart.draw(data, options);
  }
</script>

<script>
  var xValues = [];
  var yValues = [];
  var barColors = [
    "#424649",
    "#6366f1",
    "#06b6d4",
    "#10b981",
    "#f59e0b",
    "#ec4899",
    "#8b5cf6",
    "#3b82f6",
    "#14b8a6",
    "#84cc16",
    "#eab308",
    "#f97316",
    "#ef4444"
  ];

  const paymentMethodBar = JSON.parse('<%- JSON.stringify(orderBar) %>');

  paymentMethodBar.forEach((item) => {
    xValues.push(item.totalQuantitySold);
    yValues.push(item.productName);
  });

  new Chart("myChart", {
    type: "horizontalBar",
    data: {
      labels: yValues,
      datasets: [
        {
          backgroundColor: barColors,
          data: xValues,
        },
      ],
    },
    options: {
      indexAxis: "y",
      legend: { display: false },
      title: {
        display: false,
      },
      scales: {
        xAxes: [{
          gridLines: { color: "#f3f4f6" },
          ticks: { beginAtZero: true }
        }],
        yAxes: [{
          gridLines: { display: false }
        }]
      }
    },
  });
</script>

<!-- banner.ejs -->

<%- include('../partials/admin/header') %>

<style>
  .crop-banner {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 4;
    width: 30rem;
  }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>

<section class="content-main">
  <div class="content-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="content-title card-title">Banner Management</h2>
    </div>
    <div>
      <a href="#addBanner" data-bs-toggle="modal">
        <button type="button" class="btn btn-dark"><i class="material-icons md-add me-1"></i> Add Banner</button>
      </a>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Image</th>
              <th scope="col">Name</th>
              <th scope="col">Status</th>
              <th scope="col" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof banners !== 'undefined' && banners && banners.length > 0) { %> 
            <% banners.forEach((banner, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td>
                <% if(banner.images && banner.images.length > 0) { %>
                  <% banner.images.forEach(image => { %>
                  <img
                    width="80"
                    class="rounded img-thumbnail"
                    src="/uploads/banners/<%= image.folderName %>/<%= image.filename %>"
                    alt="<%= banner.name %>"
                  />
                  <% }) %>
                <% } else { %>
                  <span class="text-muted">No Image</span>
                <% } %>
              </td>
              <td><strong><%= banner.name %></strong></td>
              <td>
                <% if (banner.isActive) { %>
                <span class="badge rounded-pill alert-success">Listed</span>
                <% } else { %>
                <span class="badge rounded-pill alert-danger">Unlisted</span>
                <% } %>
              </td>
              <td class="text-end">
                <button type="button" onclick="deleteBanner('<%= banner._id %>')" class="btn btn-sm btn-danger">
                  Delete
                </button>
              </td>
            </tr>
            <% }) %> 
            <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-4 text-muted">No banners found</td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Banner ADD Modal -->
  <div class="modal fade" id="addBanner" tabindex="-1" aria-labelledby="addBannerLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addBannerLabel">Add New Banner</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="new-banner" enctype="multipart/form-data">
            <div class="err mb-3 text-danger"></div>
            <div class="mb-3">
              <label class="form-label">Banner Name</label>
              <input type="text" class="form-control" name="banner_name" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Banner Description</label>
              <textarea name="description" id="banner_description" rows="4" class="form-control"></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label">Banner Image</label>
              <div class="d-flex align-items-center gap-3 mb-2">
                <img id="banner_prev" class="border rounded img-thumbnail" style="display: none; max-width: 150px;" src="" alt="" />
              </div>
              <input
                id="banner_image"
                name="banner_images"
                type="file"
                accept=".jpg,.jpeg,.png,.webp,.svg,.avif,.gif"
                class="form-control"
                required
                multiple
              />
              <input id="cropped_banner" type="hidden" name="" value="" />
            </div>
            <div class="d-flex justify-content-end gap-2 mt-4">
              <button type="reset" class="btn btn-secondary px-4">Clear</button>
              <button type="submit" class="btn btn-dark px-4">Submit</button>
            </div>
          </form>
          <div style="display: none" class="crop-banner card p-3 shadow" id="banner-crp-container">
            <div class="d-flex flex-column">
              <img src="" id="bannerIMG" style="object-fit: cover" class="img-fluid" />
              <button id="cropImageBtn" class="btn btn-dark mt-3">Crop Image</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/admin/footer') %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />

<script>
  const modal = document.getElementById("addBanner");
  const bannerForm = document.getElementById("new-banner");
  const bannerImageInput = document.getElementById("banner_image");
  const bannerPrevImg = document.getElementById("banner_prev");

  let imageFiles = [];

  // Handle image preview on file change
  bannerImageInput.addEventListener("change", function (e) {
    const files = e.target.files;

    if (files && files.length > 0) {
      [...files].forEach((file, index) => {
        const reader = new FileReader();
        reader.onload = function (e) {
          if (index === 0) {
            bannerPrevImg.src = e.target.result;
            bannerPrevImg.style.display = "block";
          }
        };
        reader.readAsDataURL(file);
        imageFiles.push(file);
      });
    }
  });

  // Handle form submission
  bannerForm.addEventListener("submit", async function (e) {
    e.preventDefault();

    const formData = new FormData(bannerForm);

    imageFiles.forEach((file) => {
      formData.append("banner_images", file);
    });

    try {
      const response = await fetch("/admin/banner/add-banner", {
        method: "POST",
        body: formData,
      });

      if (response.ok) {
        const result = await response.json();
        Swal.fire({
          icon: "success",
          title: "Banner Uploaded",
          text: result.message || "Your banner has been uploaded successfully!",
          confirmButtonText: "OK",
        }).then(() => {
          window.location.reload();
        });
      } else {
        throw new Error("Failed to upload images");
      }
    } catch (error) {
      Swal.fire({
        icon: "error",
        title: "Upload Failed",
        text: error.message,
        confirmButtonText: "OK",
      });
    }
  });

  function resetForm() {
    bannerForm.reset();
    imageFiles = [];
    bannerPrevImg.style.display = "none";
  }

  async function deleteBanner(bannerId) {
    const result = await Swal.fire({
      title: "Are you sure?",
      text: "You will not be able to recover this banner!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#424649",
      cancelButtonColor: "#d33",
      confirmButtonText: "Yes, delete it!"
    });

    if (result.isConfirmed) {
      try {
        const response = await fetch(`/admin/banner/delete-banner/${bannerId}`, {
          method: "DELETE",
          headers: {
            "Content-Type": "application/json"
          }
        });

        const data = await response.json();
        if (response.ok && data.success) {
          Swal.fire({
            icon: "success",
            title: "Deleted!",
            text: data.message || "Banner deleted successfully.",
            confirmButtonText: "OK"
          }).then(() => {
            window.location.reload();
          });
        } else {
          throw new Error(data.message || "Failed to delete banner");
        }
      } catch (error) {
        Swal.fire({
          icon: "error",
          title: "Error",
          text: error.message || "Something went wrong!"
        });
      }
    }
  }
</script>

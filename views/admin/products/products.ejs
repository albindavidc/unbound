<!-- products.ejs -->

<%- include("../../partials/admin/header") %>

<style>
  .product-thumb {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #e9ecef;
  }
  .custom-table th {
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #424649;
    background-color: #f8f9fa;
    border-bottom: 2px solid #e9ecef;
    padding: 12px 16px;
  }
  .custom-table td {
    padding: 12px 16px;
    vertical-align: middle;
  }
</style>

<!-- Show Products -->
<section class="content-main">
  <div class="content-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="content-title card-title">Products</h2>
      <p class="text-muted font-sm">Manage your product catalog, stock levels, and visibility</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin/stocks" class="btn btn-outline-dark d-inline-flex align-items-center gap-1">
        <i class="material-icons md-inventory_2"></i> Manage Stocks
      </a>
      <a href="/admin/add-product" class="btn btn-dark d-inline-flex align-items-center gap-1">
        <i class="material-icons md-add"></i> Add Product
      </a>
    </div>
  </div>

  <div class="card mb-4">
    <header class="card-header bg-white border-0 py-3">
      <div class="row gx-3 align-items-center">
        <div class="col-lg-6 col-md-8 col-12 mx-auto">
          <form action="/admin/products" method="get">
            <div class="input-group search-bar-modern">
              <span class="input-group-text border-0 text-muted px-3">
                <i class="material-icons md-search"></i>
              </span>
              <input type="text" class="form-control border-0 px-2 shadow-none" placeholder="Search products..." name="search" />
              <button class="btn btn-dark" type="submit">Search</button>
            </div>
          </form>
        </div>
      </div>
    </header>

    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle custom-table mb-0">
          <thead>
            <tr>
              <th>#</th>
              <th>Image</th>
              <th>Name</th>
              <th>Category</th>
              <th>Price</th>
              <th>Stock</th>
              <th>Status</th>
              <th>Edit</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (product && product.length > 0) { %> 
            <% product.forEach((item, index) => { %>
            <tr>
              <td class="fw-bold"><%= index + 1 %></td>

              <td>
                <img
                  class="product-thumb shadow-sm"
                  src="/uploads/images/<%= item.primaryImages && item.primaryImages.length > 0 ? item.primaryImages[0].name : 'default.jpg' %>"
                  alt="<%= item.name %>"
                />
              </td>
              <td class="fw-bold text-dark"><%= item.name %></td>
              <td>
                <span class="badge bg-light text-dark border px-2 py-1"><%= item.category ? item.category.name : 'Uncategorized' %></span>
              </td>
              <td class="fw-bold text-dark">₹<%= item.sellingPrice %></td>

              <td>
                <% let totalStock = 0; %> 
                <% if(item.variants) { %>
                  <% item.variants.forEach(variant => { totalStock += variant.stock; }); %> 
                <% } %>
                <% if (totalStock > 0) { %>
                <span class="badge rounded-pill alert-success">In Stock (<%= totalStock %>)</span>
                <% } else { %>
                <span class="badge rounded-pill alert-danger">Out Of Stock</span>
                <% } %>
              </td>

              <td>
                <% if (item.isActive) { %>
                <span class="badge rounded-pill alert-success">Listed</span>
                <% } else { %>
                <span class="badge rounded-pill alert-danger">Unlisted</span>
                <% } %>
              </td>
              <td>
                <a href="/admin/edit-product/<%= item._id %>" class="btn btn-sm btn-dark d-inline-flex align-items-center gap-1">
                  <i class="material-icons md-edit" style="font-size: 16px;"></i> Edit
                </a>
              </td>
              <td class="text-end">
                <% if (item.isActive) { %>
                <button class="btn btn-danger btn-sm px-3" onclick="confirmAction('<%= item._id %>', 'unlist', '<%= item.name %>')">
                  Unlist
                </button>
                <% } else { %>
                <button class="btn btn-success btn-sm px-3" onclick="confirmAction('<%= item._id %>', 'list', '<%= item.name %>')">
                  List
                </button>
                <% } %>
              </td>
            </tr>
            <% }) %> 
            <% } else { %>
            <tr>
              <td colspan="9" class="text-center py-5 text-muted">No products found</td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%- include('.././pagination') %>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>

<script>
  // List or Unlist Product Confirmation
  const confirmAction = (productId, action, productName) => {
    let actionText, confirmButtonText;

    switch (action) {
      case "list":
        actionText = "list";
        confirmButtonText = "Yes, List it!";
        break;
      case "unlist":
        actionText = "unlist";
        confirmButtonText = "Yes, Unlist it!";
        break;
      case "delete":
        actionText = "delete";
        confirmButtonText = "Yes, Delete it!";
        break;
      default:
        return;
    }

    Swal.fire({
      title: "Are you sure?",
      text: `Do you want to ${actionText} the product: ${productName}?`,
      icon: "warning",
      showCancelButton: true,
      confirmButtonText: confirmButtonText,
      cancelButtonText: "No, cancel!",
      showConfirmButton: true,
      reverseButtons: true,
      timer: 5000,
      timerProgressBar: true,
    }).then((result) => {
      if (result.isConfirmed) {
        if (action === "delete") {
          deleteProduct(productId);
        } else {
          const shouldList = action === "list";
          unlistOrListProduct(productId, shouldList);
        }
      }
    });
  };

  const unlistOrListProduct = async (productId, shouldList) => {
    try {
      const response = await fetch("/admin/product/action", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ productId, shouldList }),
      });
      const result = await response.json();
      if (result.success) {
        Swal.fire({
          title: "Success!",
          text: shouldList ? "Product has been listed." : "Product has been unlisted.",
          icon: "success",
          showCancelButton: false,
          timer: 1500,
        }).then(() => {
          location.reload();
        });
      } else {
        Swal.fire({
          title: "Error!",
          text: "Something went wrong.",
          icon: "error",
          showCancelButton: false,
          timer: 1500,
        });
      }
    } catch (error) {
      Swal.fire({
        title: "Error!",
        text: "Something went wrong.",
        icon: "error",
        showCancelButton: false,
        timer: 1500,
      });
    }
  };

  const deleteProduct = async (productId) => {
    try {
      const response = await fetch("/admin/product/deleteProduct", {
        method: "DELETE",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ productId }),
      });
      const result = await response.json();
      if (result.success) {
        Swal.fire({
          title: "Deleted!",
          text: "Product has been deleted.",
          icon: "success",
          showCancelButton: false,
          timer: 1500,
        }).then(() => {
          location.reload();
        });
      } else {
        Swal.fire({
          title: "Error!",
          text: "Something went wrong.",
          icon: "error",
          showCancelButton: false,
          timer: 1500,
        });
      }
    } catch (error) {
      Swal.fire({
        title: "Error!",
        text: "Something went wrong.",
        icon: "error",
        showCancelButton: false,
        timer: 1500,
      });
    }
  };
</script>

<%- include("../../partials/admin/footer") %>

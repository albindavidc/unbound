<!-- orderList.ejs -->

<%- include('../partials/admin/header') %>

<style>
  .custom-table th {
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #424649;
    background-color: #f8f9fa;
    border-bottom: 2px solid #e9ecef;
    padding: 12px 16px;
  }
  .custom-table td {
    padding: 14px 16px;
    vertical-align: middle;
  }
  .product-item {
    line-height: 1.3;
  }
  .status-wrapper {
    min-height: 48px;
    display: flex;
    align-items: center;
  }
</style>

<!-- Order Management Header -->
<section class="content-main">
  <div class="content-header mb-4">
    <div>
      <h2 class="content-title card-title">Order Management</h2>
      <p class="text-muted font-sm">Manage and track user orders and delivery statuses</p>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <% if (orders && orders.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle custom-table mb-0">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Customer</th>
              <th scope="col">Date</th>
              <th scope="col">Payment</th>
              <th scope="col">Status</th>
              <th scope="col">Amount</th>
              <th scope="col">Products</th>
              <th scope="col">Customized</th>
              <th scope="col">Delivery Status</th>
              <th scope="col" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach((order, index) => { %>
            <tr>
              <td class="fw-bold"><%= (currentPage - 1) * perPage + index + 1 %></td>
              <td>
                <div class="fw-bold text-dark"><%= order.customerId ? order.customerId.name : 'Unknown User' %></div>
                <small class="text-muted"><%= order.customerId ? order.customerId.email : '' %></small>
              </td>
              <td>
                <span class="text-body"><%= order.createdAt ? order.createdAt.toLocaleDateString('en-GB') : 'N/A' %></span>
              </td>
              <td>
                <span class="badge bg-light text-dark border px-2 py-1"><%= order.paymentMethod %></span>
              </td>
              <td>
                <% order.items.forEach((item) => { %>
                <div class="status-wrapper">
                  <% if (item.paymentStatus === 'Paid') { %>
                    <span class="badge rounded-pill alert-success">Paid</span>
                  <% } else if (item.paymentStatus === 'Pending') { %>
                    <span class="badge rounded-pill alert-warning">Pending</span>
                  <% } else { %>
                    <span class="badge rounded-pill alert-danger"><%= item.paymentStatus %></span>
                  <% } %>
                </div>
                <% }) %>
              </td>
              <td>
                <% order.items.forEach((item) => { %>
                <div class="status-wrapper fw-bold text-dark">
                  ₹<%= item.productId ? item.productId.sellingPrice : 0 %>
                </div>
                <% }) %>
              </td>
              <td>
                <% order.items.forEach((item) => { %>
                <div class="status-wrapper product-item">
                  <div>
                    <div class="fw-semibold text-dark"><%= item.productId ? item.productId.name : 'Product' %></div>
                    <small class="text-muted">Qty: <%= item.quantity %></small>
                  </div>
                </div>
                <% }) %>
              </td>

              <td>
                <% order.items.forEach(item => { %>
                <div class="status-wrapper">
                  <% if (item.customized === true) { %>
                  <a
                    href="/admin/customize-download/<%= order._id %>/<%= item.productId._id %>"
                    class="btn btn-sm btn-dark d-inline-flex align-items-center gap-1"
                  >
                    <i class="material-icons md-download" style="font-size:16px;"></i> Download
                  </a>
                  <% } else { %>
                  <span class="text-muted fs-6">No</span>
                  <% } %>
                </div>
                <% }) %>
              </td>

              <td>
                <% order.items.forEach((item, itemIndex) => { %>
                <div class="status-wrapper">
                  <select
                    class="form-select form-select-sm"
                    style="min-width: 130px;"
                    id="deliveryStatus-<%= order._id %>-<%= itemIndex %>"
                    data-order-id="<%= order._id %>"
                    data-item-index="<%= itemIndex %>"
                    aria-label="Select Delivery Status"
                  >
                    <% statuses.forEach(status => { %>
                      <option value="<%= status %>" <%= status === item.status ? 'selected' : '' %>><%= status %></option>
                    <% }); %>
                  </select>
                </div>
                <% }) %>
              </td>

              <td class="text-end">
                <% order.items.forEach((item, itemIndex) => { %>
                <div class="status-wrapper justify-content-end">
                  <% if (item.status !== "Return" && item.status !== "Cancelled") { %>
                  <button
                    type="button"
                    class="btn btn-sm btn-dark update-button px-3"
                    data-order-id="<%= order._id %>"
                    data-item-index="<%= itemIndex %>"
                  >
                    Update
                  </button>
                  <% } else { %>
                  <span class="text-muted font-xs">Locked</span>
                  <% } %>
                </div>
                <% }) %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="text-center py-5 text-muted">
        <i class="material-icons md-shopping_cart text-muted mb-2" style="font-size: 48px;"></i>
        <h5>No Orders Available</h5>
      </div>
      <% } %>
    </div>
  </div>

  <%- include('./pagination') %>
</section>

<%- include('../partials/admin/footer') %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  document.querySelectorAll(".update-button").forEach((button) => {
    button.addEventListener("click", async function (e) {
      e.preventDefault();

      const orderId = this.getAttribute("data-order-id");
      const itemIndex = this.getAttribute("data-item-index");
      const selectedStatus = document.querySelector(`#deliveryStatus-${orderId}-${itemIndex}`).value;

      fetch(`/admin/orderList/updateOrder/${orderId}`, {
        method: "PUT",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ itemIndex, status: selectedStatus }),
      })
        .then((response) => {
          if (!response.ok) {
            return response.json().then((err) => {
              throw new Error(err.error);
            });
          }
          return response.json();
        })
        .then(() => {
          Swal.fire({
            icon: "success",
            title: "Success",
            timer: 3000,
            showConfirmButton: false,
            text: "Order updated successfully!",
          }).then(() => location.reload());
        })
        .catch((err) => {
          Swal.fire({
            icon: "error",
            title: "Oops",
            timer: 3000,
            showConfirmButton: false,
            text: "Couldn't update the status of the delivery",
          }).then(() => location.reload());
        });
    });
  });
</script>
